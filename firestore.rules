rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // قراءة وكتابة آمنة لحالة الشبكة والأحداث الفورية مع التحقق من بنية البيانات ومنع مسح الحالة بالكامل
    match /system_data/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow create, update: if isValidId(docId)
                            && request.resource != null
                            && request.resource.data.keys().size() > 0;
      allow delete: if false;
    }

    match /system_events/{eventId} {
      allow get: if isValidId(eventId);
      allow list: if true;
      allow create, update: if isValidId(eventId)
                            && request.resource != null
                            && request.resource.data.keys().size() > 0;
      allow delete: if false;
    }

    match /{collectionName}/{docId} {
      allow get: if isValidId(docId) && collectionName in [
        'batches', 'sheets', 'transfers', 'outlets',
        'deliveries', 'payments', 'direct_sales',
        'cash_handovers', 'settlements', 'damaged_cards',
        'audit_logs', 'app_settings', 'expenses'
      ];
      allow list: if collectionName in [
        'batches', 'sheets', 'transfers', 'outlets',
        'deliveries', 'payments', 'direct_sales',
        'cash_handovers', 'settlements', 'damaged_cards',
        'audit_logs', 'app_settings', 'expenses'
      ];
      allow create, update: if isValidId(docId) && collectionName in [
        'batches', 'sheets', 'transfers', 'outlets',
        'deliveries', 'payments', 'direct_sales',
        'cash_handovers', 'settlements', 'damaged_cards',
        'audit_logs', 'app_settings', 'expenses'
      ] && request.resource != null && request.resource.data.keys().size() > 0;
      allow delete: if false;
    }
  }
}
